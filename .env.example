# EmailJS keys for the Queries & Collaboration form (https://dashboard.emailjs.com)
# Copy to .env.local for local dev, and add the same three variables in Vercel → Project → Settings → Environment Variables.
# If any is missing, the form falls back to opening a pre-filled email.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
